import React, {
  useState,
  useEffect,
  useCallback,
  useMemo,
  useRef,
} from "react";
import {
  Plus,
  Copy,
  Clipboard,
  Trash2,
  Scissors,
  Search,
  Globe,
  Terminal,
  Music,
  Pencil,
} from "lucide-react";
import { useDeviceStore } from "../stores/deviceStore";
import { useProfileStore } from "../stores/profileStore";
import { DEVICE_SPECS } from "../../shared/constants";
import {
  DndContext,
  closestCenter,
  KeyboardSensor,
  PointerSensor,
  useSensor,
  useSensors,
  DragEndEvent,
  DragStartEvent,
} from "@dnd-kit/core";
import {
  arrayMove,
  SortableContext,
  sortableKeyboardCoordinates,
  verticalListSortingStrategy,
  rectSortingStrategy,
  useSortable,
} from "@dnd-kit/sortable";
import { CSS } from "@dnd-kit/utilities";
import { ContextMenu } from "./ContextMenu";
import { SortableKey } from "./SortableKey";
import type {
  DeviceInfo,
  Profile,
  KeyConfig,
  Action,
} from "../../shared/types";

interface StreamdeckViewProps {
  device: DeviceInfo | null;
  profile: Profile | null;
  selectedKeyIndex: number | null;
  onKeySelect: (keyIndex: number) => void;
}

// Helper hook for resize observation
function useResizeObserver(ref: React.RefObject<HTMLElement>) {
  const [dimensions, setDimensions] = useState({ width: 0, height: 0 });

  useEffect(() => {
    if (!ref.current) return;

    const observeTarget = ref.current;
    const resizeObserver = new ResizeObserver((entries) => {
      entries.forEach((entry) => {
        setDimensions({
          width: entry.contentRect.width,
          height: entry.contentRect.height,
        });
      });
    });

    resizeObserver.observe(observeTarget);

    return () => {
      resizeObserver.unobserve(observeTarget);
    };
  }, [ref]);

  return dimensions;
}

export function StreamdeckView({
  device,
  profile,
  selectedKeyIndex,
  onKeySelect,
}: StreamdeckViewProps) {
  const { pressedKeys } = useDeviceStore();
  const { updateKeyConfig } = useProfileStore();
  const containerRef = useRef<HTMLDivElement>(null);
  const { width: containerWidth, height: containerHeight } =
    useResizeObserver(containerRef);

  const [contextMenu, setContextMenu] = useState<{
    x: number;
    y: number;
    keyIndex: number;
  } | null>(null);
  const [clipboard, setClipboard] = useState<Partial<KeyConfig> | null>(null);
  const [activeDragId, setActiveDragId] = useState<string | null>(null);
  const [selectedIndices, setSelectedIndices] = useState<Set<number>>(
    new Set(),
  );
  const [lastSelectedIndex, setLastSelectedIndex] = useState<number | null>(
    null,
  );
  const [quickActionIndex, setQuickActionIndex] = useState<number | null>(null);
  const [searchQuery, setSearchQuery] = useState("");
  const [draggedOverIndex, setDraggedOverIndex] = useState<number | null>(null);

  // Escape key handler for quick action modal
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape" && quickActionIndex !== null) {
        setQuickActionIndex(null);
        setSearchQuery("");
      }
    };
    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, [quickActionIndex]);

  const sensors = useSensors(
    useSensor(PointerSensor, { activationConstraint: { distance: 8 } }),
    useSensor(KeyboardSensor, {
      coordinateGetter: sortableKeyboardCoordinates,
    }),
  );

  const specs = useMemo(
    () => (device ? DEVICE_SPECS[device.type] : null),
    [device],
  );
  const currentPage = profile?.pages[profile.activePage];
  const keys = currentPage?.keys || [];

  const handleContextMenu = (e: React.MouseEvent, keyIndex: number) => {
    e.preventDefault();
    setContextMenu({ x: e.clientX, y: e.clientY, keyIndex });
    onKeySelect(keyIndex);
  };

  const handleCopy = useCallback(
    (index: number) => {
      const config = keys.find((k) => k.keyIndex === index);
      if (config) {
        const { id, keyIndex, ...rest } = config;
        setClipboard(rest);
      }
      setContextMenu(null);
    },
    [keys],
  );

  const handlePaste = useCallback(
    async (index: number) => {
      if (clipboard) {
        await updateKeyConfig(index, {
          ...clipboard,
          action: clipboard.action
            ? { ...clipboard.action, id: crypto.randomUUID() }
            : undefined,
        });
      }
      setContextMenu(null);
    },
    [clipboard, updateKeyConfig],
  );

  const handleClear = useCallback(
    async (index: number) => {
      await updateKeyConfig(index, {
        action: undefined,
        image: undefined,
        label: undefined,
      });
      setContextMenu(null);
    },
    [updateKeyConfig],
  );

  const handleKeyClick = (e: React.MouseEvent, index: number) => {
    e.stopPropagation();

    let newSelection = new Set(selectedIndices);

    if (e.shiftKey && lastSelectedIndex !== null) {
      // Range selection
      const start = Math.min(lastSelectedIndex, index);
      const end = Math.max(lastSelectedIndex, index);
      for (let i = start; i <= end; i++) {
        newSelection.add(i);
      }
    } else if (e.ctrlKey || e.metaKey) {
      // Toggle selection
      if (newSelection.has(index)) {
        newSelection.delete(index);
      } else {
        newSelection.add(index);
      }
      setLastSelectedIndex(index);
    } else {
      // Single selection
      newSelection = new Set([index]);
      setLastSelectedIndex(index);
      onKeySelect(index);
    }

    setSelectedIndices(newSelection);
  };

  const handleDuplicate = useCallback(
    async (index: number) => {
      const config = keys.find((k) => k.keyIndex === index);
      if (config && specs && index < specs.keyCount - 1) {
        const { id, keyIndex, ...rest } = config;
        await updateKeyConfig(index + 1, {
          ...rest,
          action: rest.action
            ? { ...rest.action, id: crypto.randomUUID() }
            : undefined,
        });
      }
      setContextMenu(null);
    },
    [keys, specs, updateKeyConfig],
  );

  const handleDragStart = (event: DragStartEvent) => {
    setActiveDragId(event.active.id as string);
  };

  const handleQuickActionSelect = async (actionPayload: any) => {
    if (quickActionIndex !== null) {
      await updateKeyConfig(quickActionIndex, {
        action: { ...actionPayload, id: crypto.randomUUID() },
        label: actionPayload.name,
      });
      setQuickActionIndex(null);
      setSearchQuery("");
    }
  };

  const POPULAR_ACTIONS = [
    {
      type: "keyboard-shortcut",
      name: "Mute Discord",
      icon: <Music size={14} />,
      payload: { keys: ["m"], modifiers: ["ctrl", "shift"] },
    },
    {
      type: "launch-app",
      name: "Terminal",
      icon: <Terminal size={14} />,
      payload: { command: "xterm" },
    },
    {
      type: "multimedia",
      name: "Volume Up",
      icon: <Plus size={14} />,
      payload: { mediaCommand: "volume-up" },
    },
    {
      type: "open-url",
      name: "Google",
      icon: <Globe size={14} />,
      payload: { url: "https://google.com" },
    },
  ];

  const handleDragEnd = async (event: DragEndEvent) => {
    const { active, over } = event;
    setActiveDragId(null);
    setDraggedOverIndex(null);

    if (over && active.id !== over.id) {
      const activeIndex = parseInt(active.id as string);
      const overIndex = parseInt(over.id as string);

      const activeConfig = keys.find((k) => k.keyIndex === activeIndex);
      const overConfig = keys.find((k) => k.keyIndex === overIndex);

      if (activeConfig) {
        const { id: aId, keyIndex: aIdx, ...aData } = activeConfig;
        const bData = overConfig ? { ...overConfig } : null;

        // Replace behavior: Move A to B, Clear A. B is overwritten.
        await updateKeyConfig(overIndex, {
          ...aData,
          action: aData.action
            ? { ...aData.action, id: crypto.randomUUID() }
            : undefined,
        });

        // Clear the source key (Move operation)
        await updateKeyConfig(activeIndex, {
          action: undefined,
          image: undefined,
          label: undefined,
        });

        // Immediately update hardware for both keys
        if (device && profile) {
          try {
            // Get updated configs after the moves
            const updatedPage = profile.pages[profile.activePage];
            const newOverConfig = updatedPage?.keys.find(
              (k) => k.keyIndex === overIndex,
            );
            const newActiveConfig = updatedPage?.keys.find(
              (k) => k.keyIndex === activeIndex,
            );

            // Render and send to hardware
            if (newOverConfig) {
              const actionEngine = await (window as any).bigdeck?.action;
              const imageBuffer = await actionEngine.renderKeyImage(
                newOverConfig,
                device.type,
              );
              await (window as any).bigdeck?.device.setKeyImage(
                device.id,
                overIndex,
                imageBuffer,
              );
            }
            if (newActiveConfig) {
              const actionEngine = await (window as any).bigdeck?.action;
              const imageBuffer = await actionEngine.renderKeyImage(
                newActiveConfig,
                device.type,
              );
              await (window as any).bigdeck?.device.setKeyImage(
                device.id,
                activeIndex,
                imageBuffer,
              );
            }
          } catch (error) {
            console.error("Failed to update hardware after drag:", error);
          }
        }
      }
    }
  };

  const handleNativeDrop = async (e: React.DragEvent, targetIndex: number) => {
    e.preventDefault();
    try {
      const dataStr = e.dataTransfer.getData("bigdeck/action");
      if (dataStr) {
        const actionPayload = JSON.parse(dataStr);
        await updateKeyConfig(targetIndex, {
          action: { ...actionPayload, id: crypto.randomUUID() },
          label: actionPayload.name,
        });
      }
    } catch (err) {
      console.error("Failed to handle native drop:", err);
    }
  };

  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      // Ignore if typing in an input
      if (
        document.activeElement?.tagName === "INPUT" ||
        document.activeElement?.tagName === "TEXTAREA"
      )
        return;

      if (e.ctrlKey && e.key === "c") {
        e.preventDefault();
        const index = Array.from(selectedIndices)[0];
        if (index !== undefined) handleCopy(index);
      }
      if (e.ctrlKey && e.key === "v") {
        e.preventDefault();
        selectedIndices.forEach((index) => handlePaste(index));
      }
      if (e.ctrlKey && e.key === "x") {
        e.preventDefault();
        const firstIndex = Array.from(selectedIndices)[0];
        if (firstIndex !== undefined) {
          handleCopy(firstIndex);
          selectedIndices.forEach((index) => handleClear(index));
          setSelectedIndices(new Set());
        }
      }
      if (e.key === "Delete" || e.key === "Backspace") {
        e.preventDefault();
        selectedIndices.forEach((index) => handleClear(index));
        setSelectedIndices(new Set());
      }
    };

    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, [selectedIndices, handleCopy, handlePaste, handleClear]);

  if (!device || !specs) {
    return (
      <div className="flex flex-col items-center justify-center text-center p-8 min-h-[400px]">
        <div className="w-24 h-24 flex items-center justify-center mb-6 animate-pulse">
          <img
            src="/src/renderer/assets/icon.png"
            className="w-full h-full object-contain opacity-50"
            alt="Disconnected"
          />
        </div>
        <h2 className="text-2xl font-black mb-2 tracking-tight">
          DISCONNECTED
        </h2>
        <p className="text-muted-foreground max-w-sm text-sm font-medium">
          Connect your Elgato Stream Deck to begin orchestration.
        </p>
      </div>
    );
  }

  const renderKey = (keyIndex: number) => {
    const config = keys.find((k) => k.keyIndex === keyIndex);
    const isPressed = pressedKeys.has(keyIndex);
    const isSelected = selectedIndices.has(keyIndex);
    const hasAction = !!config?.action;
    const hasImage = !!config?.image;
    const isEmpty = !hasAction && !hasImage;

    return (
      <SortableKey
        key={keyIndex}
        id={keyIndex.toString()}
        disabled={!!contextMenu}
        isSelected={isSelected}
      >
        <div className="relative w-full h-full group/key">
          <button
            onClick={(e) => {
              if (isEmpty) {
                setQuickActionIndex(keyIndex);
              } else {
                handleKeyClick(e, keyIndex);
              }
            }}
            onContextMenu={(e) => handleContextMenu(e, keyIndex)}
            onDragEnter={() => setDraggedOverIndex(keyIndex)}
            onDragLeave={() => setDraggedOverIndex(null)}
            onDragOver={(e) => e.preventDefault()}
            onDrop={(e) => handleNativeDrop(e, keyIndex)}
            className={`
               streamdeck-key relative transition-all duration-200 rounded-xl overflow-hidden border-2 w-full h-full
               ${isPressed ? "active ring-4 ring-primary/30 scale-95" : ""}
               ${isSelected ? "selected ring-2 ring-primary bg-primary/10 border-primary" : "border-border/50 hover:border-primary/50"}
               ${draggedOverIndex === keyIndex ? "ring-4 ring-primary/50 bg-primary/20 border-primary" : ""}
               ${isEmpty ? "empty border-dashed bg-muted/5 backdrop-blur-sm opacity-50 hover:opacity-100 hover:bg-muted/10" : "bg-muted/20 shadow-lg opacity-100"}
             `}
            style={{
              backgroundColor: config?.image?.backgroundColor,
            }}
          >
            {/* Key Content */}
            {hasImage ? (
              <div className="absolute inset-0 flex items-center justify-center pointer-events-none">
                {config?.image?.type === "text" && (
                  <span
                    className="text-center px-1 font-bold leading-tight tracking-tight whitespace-pre-wrap"
                    style={{
                      color: config.image.textColor,
                      fontSize: `${config.image.fontSize || 12}px`,
                    }}
                  >
                    {config.image.text}
                  </span>
                )}
                {config?.image?.type === "icon" && (
                  <img
                    src={config.image.source}
                    alt=""
                    className="w-10 h-10 object-contain drop-shadow-md"
                  />
                )}
                {config?.image?.type === "static" && (
                  <img
                    src={config.image.source}
                    alt=""
                    className="w-full h-full object-cover"
                  />
                )}
              </div>
            ) : hasAction ? (
              <div className="absolute inset-0 flex flex-col items-center justify-center pointer-events-none p-2">
                <div className="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center mb-1 text-primary">
                  <Plus size={16} className="opacity-40" />
                </div>
                <div className="text-[9px] font-black text-center text-muted-foreground uppercase tracking-widest truncate w-full">
                  {config.label ||
                    (config.action ? config.action.name : "") ||
                    (config.action ? config.action.type.replace("-", " ") : "")}
                </div>
              </div>
            ) : (
              <div className="absolute inset-0 flex items-center justify-center opacity-0 group-hover/key:opacity-100 transition-opacity bg-primary/5">
                <Plus size={24} className="text-primary/40" />
              </div>
            )}

            {/* Label Overlay - 2 line support */}
            {config?.label && (
              <div
                className={`
                  absolute left-0 right-0 text-[10px] font-black tracking-tighter text-center px-1 py-1 leading-[1.1]
                  ${config.labelPosition === "top" ? "top-0 bg-gradient-to-b from-black/60 to-transparent" : ""}
                  ${config.labelPosition === "center" ? "top-1/2 -translate-y-1/2" : ""}
                  ${config.labelPosition === "bottom" || !config.labelPosition ? "bottom-0 bg-gradient-to-t from-black/60 to-transparent" : ""}
                `}
                style={{ color: config.labelColor || "#ffffff" }}
              >
                <div className="line-clamp-2 break-words">{config.label}</div>
              </div>
            )}

            {/* Highlight for Clipboards */}
            {clipboard && (
              <div className="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-primary opacity-0 group-hover/key:opacity-100 transition-opacity ring-2 ring-background" />
            )}
          </button>

          {/* Quick Actions Overlay */}
          {!isEmpty && (
            <div className="absolute -top-2 -right-2 flex gap-1 opacity-0 group-hover/key:opacity-100 transition-all duration-200 z-20 scale-90 group-hover/key:scale-100">
              <button
                onClick={(e) => {
                  e.stopPropagation();
                  handleClear(keyIndex);
                }}
                className="w-8 h-8 rounded-full bg-destructive text-destructive-foreground shadow-lg flex items-center justify-center hover:scale-110 transition-transform"
                aria-label={`Delete key ${keyIndex + 1}`}
                title="Delete"
              >
                <Trash2 size={10} />
              </button>
            </div>
          )}
          {!isEmpty && (
            <div className="absolute -top-2 -left-2 flex gap-1 opacity-0 group-hover/key:opacity-100 transition-all duration-200 z-20 scale-90 group-hover/key:scale-100">
              <button
                onClick={(e) => {
                  e.stopPropagation();
                  onKeySelect(keyIndex);
                }}
                className="w-8 h-8 rounded-full bg-secondary text-secondary-foreground shadow-lg flex items-center justify-center hover:scale-110 transition-transform"
                aria-label={`Edit key ${keyIndex + 1}`}
                title="Edit"
              >
                <Pencil size={10} />
              </button>
            </div>
          )}
        </div>
      </SortableKey>
    );
  };

  // Calculate grid dimensions
  // We want the entire "Device" to scale to fit the container while maintaining aspect ratio
  const deviceStyle = useMemo(() => {
    if (!specs || containerWidth === 0 || containerHeight === 0) return {};

    // Define standard proportions relative to key count
    // Use a fixed virtual size for calculations, then scale via CSS
    const virtualKeySize = 100;
    const gap = 15;
    const padding = 30; // bezel size

    const virtualWidth =
      specs.columns * virtualKeySize + (specs.columns - 1) * gap + padding * 2;
    const virtualHeight =
      specs.rows * virtualKeySize + (specs.rows - 1) * gap + padding * 2;
    const aspectRatio = virtualWidth / virtualHeight;

    // Calculate scaling to fit container with margin
    const margin = 20;
    const availableW = containerWidth - margin * 2;
    const availableH = containerHeight - margin * 2;
    const containerRatio = availableW / availableH;

    let finalW, finalH;

    if (containerRatio > aspectRatio) {
      // Height constrained
      finalH = availableH;
      finalW = finalH * aspectRatio;
    } else {
      // Width constrained
      finalW = availableW;
      finalH = finalW / aspectRatio;
    }

    return {
      width: `${finalW}px`,
      height: `${finalH}px`,
      padding: `${(padding / virtualWidth) * 100}%`,
      gap: `${(gap / virtualWidth) * 100}% of width? No, let's use flex/grid with percentages or absolute calculation inside`,
    };
    // Better approach: Let CSS handle the aspect ratio and simply size the container
  }, [specs, containerWidth, containerHeight]);

  return (
    <div
      className="flex flex-col items-center justify-center w-full h-full relative p-8"
      ref={containerRef}
    >
      {/* Device Header */}
      <div className="absolute top-4 left-0 right-0 z-10 animate-in fade-in duration-700 pointer-events-none">
        <h2 className="text-2xl font-black tracking-tighter uppercase text-center opacity-10">
          {specs.name}
        </h2>
      </div>

      <DndContext
        sensors={sensors}
        collisionDetection={closestCenter}
        onDragStart={handleDragStart}
        onDragEnd={handleDragEnd}
      >
        {/* Device Frame Container */}
        <div
          className="relative"
          style={{
            transition: 'transform 0.2s ease-out',
            willChange: 'transform',
            ...(() => {
            aspectRatio: `${specs.columns * 1.1 + 0.2} / ${specs.rows * 1.1 + 0.2}`, // Rough approximation of aspect ratio including gaps/bezel
            height: "auto",
            width: "auto",
            maxHeight: "100%",
            maxWidth: "100%",
            // Fallback for strict sizing if aspect-ratio isn't perfect
            // actually, let's just use the calculated deviceStyle logic but cleaner
            ...(() => {
              if (!specs || containerWidth === 0 || containerHeight === 0)
                return {};
              const gap = 20;
              const keySize = 100;
              const padding = 40;

              const contentW =
                specs.columns * keySize +
                (specs.columns - 1) * gap +
                padding * 2;
              const contentH =
                specs.rows * keySize + (specs.rows - 1) * gap + padding * 2;
              const ratio = contentW / contentH;

              const availW = containerWidth - 64;
              const availH = containerHeight - 64;
              const availRatio = availW / availH;

              if (availRatio > ratio) {
                return { height: availH, width: availH * ratio };
              } else {
                return { width: availW, height: availW / ratio };
              }
            })(),
          }}
        >
          {/* Main Device Body */}
          <div className="w-full h-full bg-[#1a1a1a] rounded-[32px] shadow-2xl relative overflow-hidden border border-white/5 mx-auto">
            {/* Soft Glow Behind */}
            <div className="absolute inset-0 bg-primary/20 blur-[100px] -z-10" />

            {/* Inner Bezel / Gloss */}
            <div className="absolute inset-0 rounded-[32px] ring-1 ring-white/10 pointer-events-none z-20" />
            <div className="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent pointer-events-none z-10" />

            {/* Keys Grid */}
            <div
              className="w-full h-full grid"
              style={{
                padding: "6%",
                gap: "4%",
                gridTemplateColumns: `repeat(${specs.columns}, 1fr)`,
                gridTemplateRows: `repeat(${specs.rows}, 1fr)`,
              }}
            >
              <SortableContext
                items={Array.from({ length: specs.keyCount }, (_, i) =>
                  i.toString(),
                )}
                strategy={rectSortingStrategy}
              >
                {Array.from({ length: specs.keyCount }, (_, i) => renderKey(i))}
              </SortableContext>
            </div>

            {/* Outer Glow (Simulated by separate div behind) */}
            <div className="absolute -inset-4 bg-primary/20 blur-[40px] rounded-[50px] -z-10 transition-all duration-1000 opacity-60"></div>
          </div>
        </div>
      </DndContext>

      {/* Context Menu Portal */}
      {contextMenu && (
        <ContextMenu
          x={contextMenu.x}
          y={contextMenu.y}
          onCopy={() => handleCopy(contextMenu.keyIndex)}
          onPaste={() => handlePaste(contextMenu.keyIndex)}
          onCut={() => {
            handleCopy(contextMenu.keyIndex);
            handleClear(contextMenu.keyIndex);
          }}
          onClear={() => handleClear(contextMenu.keyIndex)}
          onDuplicate={() => handleDuplicate(contextMenu.keyIndex)}
          onClose={() => setContextMenu(null)}
          canPaste={!!clipboard}
        />
      )}

      {/* Quick Action Search Modal */}
      {quickActionIndex !== null && (
        <div
          className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-md animate-in fade-in duration-300"
          onClick={() => setQuickActionIndex(null)}
        >
          <div
            className="w-[400px] bg-card border border-border shadow-2xl rounded-[32px] overflow-hidden animate-in zoom-in-95 duration-200"
            onClick={(e) => e.stopPropagation()}
          >
            <div className="p-6">
              <div className="flex items-center justify-between mb-4">
                <h3 className="text-sm font-black uppercase tracking-widest text-primary">
                  Quick Assign
                </h3>
                <button
                  onClick={() => setQuickActionIndex(null)}
                  className="text-muted-foreground hover:text-foreground"
                  aria-label="Close quick assign modal"
                >
                  <Plus size={20} className="rotate-45" />
                </button>
              </div>
              <div className="relative mb-6">
                <Search
                  className="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground"
                  size={16}
                />
                <input
                  id="quick-action-search"
                  autoFocus
                  type="text"
                  placeholder="Search actions..."
                  className="w-full bg-muted/50 border-none rounded-xl py-3 pl-10 pr-4 text-sm focus:ring-2 focus:ring-primary/20 transition-all font-medium"
                  aria-label="Search quick actions"
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                />
              </div>

              <div className="space-y-2">
                <div className="text-[10px] font-black text-muted-foreground uppercase tracking-widest mb-2">
                  Most Used
                </div>
                {POPULAR_ACTIONS.filter((a) =>
                  a.name.toLowerCase().includes(searchQuery.toLowerCase()),
                ).map((action, i) => (
                  <button
                    key={i}
                    onClick={() => handleQuickActionSelect(action)}
                    className="w-full flex items-center gap-3 p-3 rounded-2xl hover:bg-primary/10 hover:text-primary transition-all text-left group"
                  >
                    <div className="w-8 h-8 rounded-lg bg-muted flex items-center justify-center group-hover:bg-primary/20">
                      {action.icon}
                    </div>
                    <div className="flex-1">
                      <div className="text-sm font-bold">{action.name}</div>
                      <div className="text-[10px] opacity-70 uppercase tracking-tighter">
                        {action.type}
                      </div>
                    </div>
                  </button>
                ))}
              </div>
            </div>
            <div className="p-4 bg-muted/30 text-center border-t border-border">
              <p className="text-[9px] font-bold text-muted-foreground uppercase tracking-widest leading-relaxed">
                OR DRAG FROM SIDEBAR LIBRARY
              </p>
            </div>
          </div>
        </div>
      )}

      {/* Keyboard Hint */}
      <div className="absolute bottom-4 left-1/2 -translate-x-1/2 opacity-30 group-hover:opacity-100 transition-opacity pointer-events-none">
        <p className="text-[9px] font-black uppercase tracking-[0.3em] text-muted-foreground">
          Ctrl+C • Ctrl+V • Del • Right Click
        </p>
      </div>
    </div>
  );
}
