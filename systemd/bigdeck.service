[Unit]
Description=BigDeck Streamdeck Controller Daemon
Documentation=https://github.com/bigdeck/bigdeck
After=network.target graphical.target

[Service]
Type=simple
ExecStart=/opt/BigDeck/bigdeck --daemon
Restart=on-failure
RestartSec=5
User=%i
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/%i/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/%U

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i/.config/bigdeck

[Install]
WantedBy=default.target
